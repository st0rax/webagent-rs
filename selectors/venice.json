    "[role='menuitem']",
    "[role='option']",
    "[data-testid*='model-option' i]"
  ],
  "attach_button": [
    "button[aria-label*='attach' i]",
    "button[aria-label*='upload' i]",
    "button[title*='attach' i]",
    "label[for*='file' i]"
  ],
  "ui_options": [
    "chat",
