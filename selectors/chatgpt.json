{
  "composer": [
    "div#prompt-textarea",
    "textarea[data-id='root']",
    "div[contenteditable='true']"
  ],
  "send_button": [
    "button[data-testid='send-button']",
    "button[aria-label='Send prompt']"
  ],
  "stop_button": [
    "button[data-testid='stop-button']",
    "button[aria-label='Stop streaming']",
    "button[aria-label='Stop generating']",
    "button[aria-label='Generierung beenden']",
    "button[aria-label*='Stop']",
    "button[aria-label*='beenden']"
  ],
  "assistant_message": [
    "div[data-message-author-role='assistant']"
  ],
  "new_chat_button": [
    "a[href='/']",
    "button[data-testid='new-chat-button']"
  ],
  "login_button": [
    "button[data-testid='login-button']",
    "text=Anmelden",
    "text=Log in"
  ],
  "login_indicator": [
    "div#prompt-textarea",
    "textarea[data-id='root']"
  ],
  "google_sso_button": [
    "button:has-text('Continue with Google')",
    "button:has-text('Sign in with Google')",
    "button:has-text('Continue to Google')",
    "button:has-text('Mit Google fortfahren')",
    "button:has-text('Weiter mit Google')",
    "button:has-text('Anmelden mit Google')",
    "button[aria-label*='Google' i]"
  ],
  "model_menu": [
    "button[data-testid='model-switcher-dropdown-button']",
    "[data-testid='model-switcher-dropdown-button']",
    "button[aria-label='Modellauswaehler']",
    "button[aria-label='Modellauswähler']",
    "button[aria-label*='Modellausw' i]"
  ],
  "model_option": [
    "[role=menuitem]",
    "[role=menuitemradio]",
    "[role=option]",
    "li[role=option]"
  ],
  "ui_options": [
    "chat",
    "new_chat",
    "model_switch",
    "file_attach",
    "voice_input",
    "voice_mode",
    "projects",
    "stop_generation"
  ]
}
