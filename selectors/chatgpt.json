{
  "composer": [
    "div[aria-label*='ChatGPT fragen' i]",
    "div[aria-label*='Ask ChatGPT' i]",
    "div#prompt-textarea",
    "textarea[data-id='root']",
    "div[contenteditable='true']"
  ],
  "send_button": [
    "button[aria-label*='Senden' i]",
    "button[aria-label*='Send' i]",
    "button[data-testid='send-button']",
    "button[aria-label='Send prompt']"
  ],
  "stop_button": [
    "button[data-testid='stop-button']",
    "button[aria-label='Stop streaming']",
    "button[aria-label='Stop generating']",
    "button[aria-label='Generierung beenden']"
  ],
  "assistant_message": [
    "div[data-dil-response]",
    "div[data-response-body]",
    "div[data-markdown-text-style='assistant-message']",
    "div[data-content-search-unit-key$=':assistant']",
    "div[data-message-author-role='assistant']"
  ],
  "user_message": [
    "div[data-user-message-bubble='true']",
    "div[data-content-search-unit-key$=':user']",
    "div[data-message-author-role='user']"
  ],
  "new_chat_button": [
    "button[aria-label*='Neuer Chat' i]",
    "button[aria-label*='New chat' i]",
    "button:has-text('Neuer Chat')",
    "a[href='/']",
    "button[data-testid='new-chat-button']"
  ],
  "login_button": [
    "button[data-testid='login-button']",
    "text=Anmelden",
    "text=Log in"
  ],
  "login_indicator": [
    "button[aria-label*='Profil' i]",
    "button[aria-label*='Profilmenü' i]",
    "button[aria-label*='Profile' i]",
    "button[aria-label*='Account' i]",
    "button[aria-label*='Konto' i]"
  ],
  "google_sso_button": [
    "button:has-text('Continue with Google')",
    "button:has-text('Sign in with Google')",
    "button:has-text('Continue to Google')",
    "button:has-text('Mit Google fortfahren')",
    "button:has-text('Weiter mit Google')",
    "button:has-text('Anmelden mit Google')",
    "button[aria-label*='Google' i]"
  ],
  "model_menu": [
    "button.__composer-pill",
    "button:has-text('Nachdenken')",
    "button[class*='__composer-pill']"
  ],
  "model_option": [
    "[role=menuitem]",
    "[role=menuitemradio]",
    "[role=option]",
    "li[role=option]"
  ],
  "ui_options": [
    "chat",
    "new_chat",
    "file_attach",
    "voice_input",
    "voice_mode",
    "projects",
    "stop_generation"
  ],
  "projects_button": [
    "text=Projekte",
    "text=Projects",
    "a:has-text('Projekte')",
    "a:has-text('Projects')"
  ],
  "image_gen_enabled": ["yes"],
  "image_gen_provider_name": ["ChatGPT"]
}
